{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node", "react", "react-dom"],
    "allowImportingTsExtensions": true, "noEmit": true,
    "baseUrl": ".", "paths": {"@/*": ["src/renderer/*"]}
  },
  "include": ["src/main", "src/preload", "src/shared", "src/renderer/src.tsx", "src/renderer/novnc.d.ts", "electron.vite.config.ts", "tests"]
}
